---
import AppLayout from "@/layouts/AppLayout.astro";
import FocusSession from "@/components/FocusSession";
import { createClient } from "@/lib/supabase";
import { currentWeekStart, loadWeekView, todayIso, type WeekView } from "@/lib/planning";
import { addDays, isIsoDate, startOfWeek } from "@/domain/date";
import { summarizeAgenda, timeRange } from "@/domain/agenda";
export const prerender = false;
const requestedWeek = Astro.url.searchParams.get("week");
const weekStart = isIsoDate(requestedWeek) ? startOfWeek(requestedWeek) : currentWeekStart();
const db = createClient(Astro.request.headers, Astro.cookies);
let week: WeekView | null = null;
let loadError: string | null = null;
try {
  if (db) week = await loadWeekView(db, weekStart);
  else loadError = "Supabase nie jest skonfigurowany";
} catch {
  loadError = "Nie udało się wczytać zajęć. Odśwież stronę.";
}
const today = todayIso();
const entries = week?.days.flatMap((day) => day.sessions) ?? [];
const nextSession = entries.find((entry) => entry.status === "planned" && entry.date >= today);
const groups = summarizeAgenda(entries);
const doneCount = entries.filter((entry) => entry.status === "done").length;
const percent = entries.length ? Math.round((doneCount / entries.length) * 100) : 0;
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const filter = Astro.url.searchParams.get("filter") ?? "all";
const dayNames = ["Poniedziałek", "Wtorek", "Środa", "Czwartek", "Piątek", "Sobota", "Niedziela"];
const visible = (session: (typeof entries)[number]) =>
  session.topicTitle.toLocaleLowerCase("pl").includes(q.toLocaleLowerCase("pl")) &&
  (filter === "done" ? session.status === "done" : filter === "planned" ? session.status === "planned" : true);
const visibleCount = entries.filter(visible).length;
const formatMinutes = (n: number) =>
  n < 60 ? String(n) + " min" : String(Math.floor(n / 60)) + " godz." + (n % 60 ? " " + String(n % 60) + " min" : "");
---

<AppLayout title="Realizacja" subtitle="Twoje zajęcia, jedna lista. Odhacz to, co już za Tobą." active="dashboard">
  {
    loadError && (
      <p role="alert" class="empty-state">
        {loadError}
      </p>
    )
  }
  {
    week && (
      <>
        <div class="page-toolbar">
          <div>
            <>
              <p class="text-ink-muted text-sm">Wybrany tydzień</p>
              <p class="tnum mt-1 font-medium" data-testid="week-range">
                {week.weekStart} – {week.weekEnd}
              </p>
            </>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              class="action-secondary"
              href={"/dashboard?week=" + addDays(weekStart, -7)}
              aria-label="Poprzedni tydzień"
            >
              ←
            </a>
            <a class="action-secondary" href="/dashboard">
              Ten tydzień
            </a>
            <a class="action-secondary" href={"/dashboard?week=" + addDays(weekStart, 7)} aria-label="Następny tydzień">
              →
            </a>
            <a
              class="action-primary"
              href={
                "/calendar?month=" +
                weekStart +
                "&day=" +
                (today >= week.weekStart && today <= week.weekEnd ? today : weekStart)
              }
            >
              + Dodaj w kalendarzu
            </a>
          </div>
        </div>
        <section class="completion-strip" aria-label="Podsumowanie tygodnia">
          <div class="completion-score">
            <>
              <strong class="tnum">
                {doneCount}
                <span> / {entries.length}</span>
              </strong>
              <p>ukończonych zajęć</p>
            </>
          </div>
          <div class="completion-meter">
            <>
              <div class="completion-track">
                <div style={"width:" + String(percent) + "%"} />
              </div>
              <p>
                {entries.length
                  ? String(percent) + "% tygodniowej listy za Tobą"
                  : "Pierwsze zajęcie dodasz w kalendarzu"}
              </p>
            </>
          </div>
          <div>
            <>
              <strong class="tnum" data-testid="completed-minutes">
                {formatMinutes(week.completedMinutes)}
              </strong>
              <p>zrealizowane</p>
            </>
          </div>
          <div>
            <>
              <strong class="tnum" data-testid="planned-minutes">
                {formatMinutes(week.plannedMinutes)}
              </strong>
              <p>do zrobienia</p>
            </>
          </div>
        </section>
        <div class="realization-layout">
          <section aria-label="Lista zajęć">
            <form method="GET" role="search" class="agenda-search">
              <input type="hidden" name="week" value={weekStart} />
              <input type="search" name="q" value={q} placeholder="Szukaj zajęcia…" aria-label="Szukaj zajęcia" />
              <select name="filter" aria-label="Status zajęć">
                <>
                  <option value="all" selected={filter === "all"}>
                    Wszystkie
                  </option>
                  <option value="planned" selected={filter === "planned"}>
                    Do zrobienia
                  </option>
                  <option value="done" selected={filter === "done"}>
                    Zrobione
                  </option>
                </>
              </select>
              <button class="action-secondary">Filtruj</button>
            </form>
            {visibleCount === 0 && (
              <div class="empty-state" data-testid="plan-empty">
                <h2>{entries.length ? "Brak pasujących zajęć" : "Tu pojawi się Twoja lista"}</h2>
                <p>
                  {entries.length
                    ? "Zmień nazwę lub filtr, żeby zobaczyć pozostałe zajęcia."
                    : "Wybierz dzień w kalendarzu i wpisz, co chcesz zrobić. Zajęcie od razu pojawi się tutaj."}
                </p>
                <a
                  class="action-primary mt-4"
                  href={
                    entries.length
                      ? "/dashboard?week=" + weekStart
                      : "/calendar?month=" + weekStart + "&day=" + weekStart
                  }
                >
                  {entries.length ? "Wyczyść filtry" : "Otwórz kalendarz"}
                </a>
              </div>
            )}
            {week.days.map(
              (day, index) =>
                day.sessions.some(visible) && (
                  <section class="agenda-day" data-testid="day-card" data-date={day.date}>
                    <header>
                      <h2>
                        {dayNames[index]}{" "}
                        <span class="tnum">
                          {day.date.slice(8)}.{day.date.slice(5, 7)}
                        </span>
                      </h2>
                      {day.date === today && <span class="today-label">Dzisiaj</span>}
                    </header>
                    <ul>
                      {day.sessions.filter(visible).map((session) => (
                        <li
                          class:list={["agenda-row", session.status === "done" && "is-done"]}
                          data-testid="session"
                          data-status={session.status}
                        >
                          <form method="POST" action={"/api/sessions/" + session.id}>
                            <input type="hidden" name="week" value={weekStart} />
                            <input type="hidden" name="status" value={session.status === "done" ? "planned" : "done"} />
                            <button
                              type="submit"
                              class="completion-check"
                              aria-label={
                                (session.status === "done" ? "Cofnij ukończenie: " : "Oznacz jako zrobione: ") +
                                session.topicTitle
                              }
                              aria-pressed={session.status === "done"}
                              data-testid={session.status === "done" ? "mark-planned" : "mark-done"}
                            >
                              {session.status === "done" ? "✓" : ""}
                            </button>
                          </form>
                          <div class="agenda-copy">
                            <h3>{session.topicTitle}</h3>
                            <p class="tnum">
                              {timeRange(session.startTime, session.minutes)} · {session.minutes} min
                              {session.status === "skipped" && " · pominięte"}
                            </p>
                          </div>
                          <a
                            class="agenda-edit"
                            href={"/calendar?month=" + session.date + "&day=" + session.date + "#entry-" + session.id}
                          >
                            Szczegóły
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ),
            )}
          </section>
          <aside class="topic-summary" aria-label="Realizacja według zajęć">
            <>
              <h2>W tym tygodniu</h2>
              <p class="text-ink-muted mt-1 mb-6 text-sm">Zajęcia o tej samej nazwie liczymy razem.</p>
            </>
            <ul data-testid="progress-list">
              {groups.map((group) => (
                <li data-testid="progress-item" data-topic-title={group.title}>
                  <div class="flex justify-between gap-3">
                    <h3>{group.title}</h3>
                    <span class="tnum">
                      <span data-testid="progress-percent">{group.percent}</span>%
                    </span>
                  </div>
                  <div class="completion-track my-3">
                    <div style={"width:" + String(group.percent) + "%"} />
                  </div>
                  <p class="text-ink-muted text-xs">
                    {group.completed} z {group.count} zajęć · {group.done} z {group.total} min
                  </p>
                </li>
              ))}
            </ul>
            {!groups.length && <p class="text-ink-muted text-sm">Podsumowanie pojawi się po dodaniu zajęć.</p>}
            {week.plannedMinutes > 0 && (
              <a class="action-secondary mt-6" href={"/api/plan/export?week=" + weekStart}>
                Eksport do kalendarza (.ics)
              </a>
            )}
          </aside>
        </div>
        {nextSession && (
          <details class="focus-disclosure">
            <summary>Minutnik skupienia · {nextSession.topicTitle}</summary>
            <div class="mt-4">
              <FocusSession
                client:load
                id={nextSession.id}
                title={nextSession.topicTitle}
                date={nextSession.date}
                minutes={nextSession.minutes}
                weekStart={weekStart}
              />
            </div>
          </details>
        )}
      </>
    )
  }
</AppLayout>
