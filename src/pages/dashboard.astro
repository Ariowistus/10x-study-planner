---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { currentWeekStart, loadWeekView, type WeekView } from "@/lib/planning";
import { addDays, startOfWeek } from "@/domain/date";

export const prerender = false;

// Unauthenticated requests never reach this page: `/dashboard` is listed in
// PROTECTED_ROUTES and the middleware redirects them to sign-in.

const requestedWeek = Astro.url.searchParams.get("week");
const weekStart = requestedWeek ? startOfWeek(requestedWeek) : currentWeekStart();

const db = createClient(Astro.request.headers, Astro.cookies);

let week: WeekView | null = null;
let loadError: string | null = null;

if (db) {
  try {
    week = await loadWeekView(db, weekStart);
  } catch (cause) {
    loadError = cause instanceof Error ? cause.message : "Could not load your plan";
  }
} else {
  loadError = "Supabase is not configured";
}

const dayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

function formatMinutes(total: number): string {
  const hours = Math.floor(total / 60);
  const minutes = total % 60;
  if (hours === 0) return `${minutes} min`;
  if (minutes === 0) return `${hours} h`;
  return `${hours} h ${minutes} min`;
}

const previousWeek = addDays(weekStart, -7);
const nextWeek = addDays(weekStart, 7);

const statusStyles: Record<string, string> = {
  planned: "bg-slate-100 text-slate-700",
  done: "bg-emerald-100 text-emerald-800",
  skipped: "bg-amber-100 text-amber-800",
};
---

<AppLayout title="This week" active="dashboard">
  {
    loadError && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{loadError}</p>
    )
  }

  {
    week && (
      <>
        <section class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-slate-200 bg-white p-6">
          <div>
            <p class="text-sm text-slate-600">Week of</p>
            <p class="text-lg font-semibold" data-testid="week-range">
              {week.weekStart} to {week.weekEnd}
            </p>
            <p class="mt-1 text-sm text-slate-600">
              <span data-testid="completed-minutes">{formatMinutes(week.completedMinutes)}</span> done ·{" "}
              <span data-testid="planned-minutes">{formatMinutes(week.plannedMinutes)}</span> still planned
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <a
              href={`/dashboard?week=${previousWeek}`}
              class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100"
            >
              Previous
            </a>
            <a
              href={`/dashboard?week=${nextWeek}`}
              class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100"
            >
              Next
            </a>
            <form method="POST" action="/api/plan/generate">
              <input type="hidden" name="weekStart" value={week.weekStart} />
              <button
                type="submit"
                data-testid="generate-plan"
                class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700"
              >
                {week.hasPlan ? "Regenerate plan" : "Generate plan"}
              </button>
            </form>
          </div>
        </section>

        {!week.hasPlan && (
          <p data-testid="plan-empty" class="mb-8 rounded-md border border-slate-200 bg-white px-4 py-6 text-slate-600">
            No sessions for this week yet. Add topics and availability on the Topics page, then generate a plan.
          </p>
        )}

        <section class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {week.days.map((day, index) => (
            <article
              class="rounded-lg border border-slate-200 bg-white p-4"
              data-testid="day-card"
              data-date={day.date}
            >
              <header class="mb-3 flex items-baseline justify-between">
                <h2 class="font-semibold">{dayNames[index]}</h2>
                <span class="text-xs text-slate-500">{day.date}</span>
              </header>

              <p class="mb-3 text-xs text-slate-500">
                <span data-testid="day-total">{day.totalMinutes}</span> of {day.availableMinutes} min used
              </p>

              {day.sessions.length === 0 ? (
                <p class="text-sm text-slate-400">Nothing scheduled</p>
              ) : (
                <ul class="space-y-3">
                  {day.sessions.map((session) => (
                    <li
                      class="rounded-md border border-slate-200 p-3"
                      data-testid="session"
                      data-status={session.status}
                    >
                      <p class="text-sm font-medium text-slate-900">{session.topicTitle}</p>
                      <p class="mt-0.5 text-xs text-slate-500">{session.minutes} min</p>

                      <span
                        class:list={`mt-2 inline-block rounded px-2 py-0.5 text-xs font-medium ${statusStyles[session.status]}`}
                      >
                        {session.status}
                      </span>

                      <div class="mt-3 flex flex-wrap gap-2">
                        {session.status !== "done" && (
                          <form method="POST" action={`/api/sessions/${session.id}`}>
                            <input type="hidden" name="status" value="done" />
                            <input type="hidden" name="week" value={week.weekStart} />
                            <button
                              type="submit"
                              data-testid="mark-done"
                              class="rounded border border-emerald-300 px-2 py-1 text-xs font-medium text-emerald-700 transition-colors hover:bg-emerald-50"
                            >
                              Done
                            </button>
                          </form>
                        )}
                        {session.status !== "skipped" && (
                          <form method="POST" action={`/api/sessions/${session.id}`}>
                            <input type="hidden" name="status" value="skipped" />
                            <input type="hidden" name="week" value={week.weekStart} />
                            <button
                              type="submit"
                              data-testid="mark-skipped"
                              class="rounded border border-amber-300 px-2 py-1 text-xs font-medium text-amber-700 transition-colors hover:bg-amber-50"
                            >
                              Skip
                            </button>
                          </form>
                        )}
                        {session.status !== "planned" && (
                          <form method="POST" action={`/api/sessions/${session.id}`}>
                            <input type="hidden" name="status" value="planned" />
                            <input type="hidden" name="week" value={week.weekStart} />
                            <button
                              type="submit"
                              data-testid="mark-planned"
                              class="rounded border border-slate-300 px-2 py-1 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-100"
                            >
                              Undo
                            </button>
                          </form>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>

        <section class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="mb-4 text-lg font-semibold">Topic progress</h2>

          {week.topics.length === 0 ? (
            <p class="text-sm text-slate-600">No topics yet.</p>
          ) : (
            <ul class="space-y-4" data-testid="progress-list">
              {week.topics.map((entry) => (
                <li data-testid="progress-item" data-topic-title={entry.topic.title}>
                  <div class="mb-1 flex items-baseline justify-between gap-4">
                    <span class="text-sm font-medium text-slate-900">{entry.topic.title}</span>
                    <span class="text-xs text-slate-500">
                      {entry.topic.completedMinutes} / {entry.topic.estimatedMinutes} min ·{" "}
                      <span data-testid="progress-percent">{entry.percentComplete}</span>%
                    </span>
                  </div>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
                    <div class="h-full rounded-full bg-slate-900" style={`width: ${entry.percentComplete}%`} />
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</AppLayout>
