---
import AppLayout from "@/layouts/AppLayout.astro";
import CalendarEntryForm from "@/components/CalendarEntryForm.astro";
import { createClient } from "@/lib/supabase";
import { loadMonthView, todayIso, type MonthView } from "@/lib/planning";
import { addMonths, isIsoDate, startOfMonth, startOfWeek, weekdayIndex } from "@/domain/date";
import { timeRange } from "@/domain/agenda";
export const prerender = false;
const today = todayIso();
const requested = Astro.url.searchParams.get("month");
const monthStart = startOfMonth(isIsoDate(requested) ? requested : today);
const requestedDay = Astro.url.searchParams.get("day");
const selectedDay =
  isIsoDate(requestedDay) && startOfMonth(requestedDay) === monthStart
    ? requestedDay
    : startOfMonth(today) === monthStart
      ? today
      : monthStart;
const db = createClient(Astro.request.headers, Astro.cookies);
let month: MonthView | null = null;
let loadError: string | null = null;
try {
  if (db) month = await loadMonthView(db, monthStart, today);
  else loadError = "Supabase nie jest skonfigurowany";
} catch {
  loadError = "Nie udało się wczytać kalendarza. Odśwież stronę.";
}
const months = [
  "Styczeń",
  "Luty",
  "Marzec",
  "Kwiecień",
  "Maj",
  "Czerwiec",
  "Lipiec",
  "Sierpień",
  "Wrzesień",
  "Październik",
  "Listopad",
  "Grudzień",
];
const weekdays = ["Poniedziałek", "Wtorek", "Środa", "Czwartek", "Piątek", "Sobota", "Niedziela"];
const day = month?.weeks.flat().find((day) => day.date === selectedDay);
---

<AppLayout title="Kalendarz" subtitle="Wybierz dzień. Wpisz zajęcie, godzinę i czas trwania." active="calendar">
  {
    loadError && (
      <p role="alert" class="empty-state">
        {loadError}
      </p>
    )
  }
  {
    month && (
      <>
        <datalist id="topic-names">
          {month.topics.map((topic) => (
            <option value={topic.title} />
          ))}
        </datalist>
        <div class="calendar-layout">
          <aside>
            <section class="month-picker" aria-label="Wybór dnia">
              <header>
                <>
                  <h2 data-testid="month-name">
                    {months[Number(monthStart.slice(5, 7)) - 1]} {monthStart.slice(0, 4)}
                  </h2>
                  <div class="flex gap-1">
                    <>
                      <a
                        class="month-arrow"
                        href={"/calendar?month=" + addMonths(monthStart, -1)}
                        data-testid="previous-month"
                        aria-label="Poprzedni miesiąc"
                      >
                        ←
                      </a>
                      <a
                        class="month-arrow"
                        href={"/calendar?month=" + addMonths(monthStart, 1)}
                        data-testid="next-month"
                        aria-label="Następny miesiąc"
                      >
                        →
                      </a>
                    </>
                  </div>
                </>
              </header>
              <div class="month-grid">
                {["Pn", "Wt", "Śr", "Cz", "Pt", "So", "Nd"].map((name) => (
                  <span class="weekday-label">{name}</span>
                ))}
                {month.weeks.flat().map((item) => (
                  <a
                    href={"/calendar?month=" + startOfMonth(item.date) + "&day=" + item.date}
                    data-testid="calendar-day"
                    data-date={item.date}
                    aria-label={item.date + ", " + String(item.sessions.length) + " zajęć"}
                    aria-current={item.date === selectedDay ? "date" : undefined}
                    class:list={[
                      "month-day",
                      !item.inMonth && "outside-month",
                      item.isToday && "is-today",
                      item.date === selectedDay && "is-selected",
                    ]}
                  >
                    <span>{Number(item.date.slice(8))}</span>
                    <span class="day-dots" aria-hidden="true">
                      {item.sessions.slice(0, 3).map((session) => (
                        <i class:list={session.status === "done" ? "dot-done" : ""} />
                      ))}
                    </span>
                  </a>
                ))}
              </div>
              <a href="/calendar" class="text-brand mt-4 inline-block text-sm font-medium">
                Przejdź do dzisiaj
              </a>
            </section>
            <section class="new-entry-panel mt-5" aria-labelledby="new-entry-heading">
              <>
                <h2 id="new-entry-heading">Dodaj zajęcie</h2>
                <p class="text-ink-muted mt-1 mb-5 text-sm">Pojawi się też na liście Realizacja.</p>
                <CalendarEntryForm date={selectedDay} month={monthStart} />
              </>
            </section>
          </aside>
          <section class="day-agenda" aria-label="Zajęcia wybranego dnia">
            <header class="day-agenda-heading">
              <>
                <div>
                  <>
                    <p class="text-brand mb-1 text-sm">{selectedDay === today ? "Dzisiaj" : "Wybrany dzień"}</p>
                    <h2>
                      {weekdays[weekdayIndex(selectedDay)]}{" "}
                      <span class="tnum text-ink-muted">
                        {selectedDay.slice(8)}.{selectedDay.slice(5, 7)}
                      </span>
                    </h2>
                    <p class="text-ink-muted mt-2 text-sm">
                      {day?.sessions.length ?? 0} zajęć · {(day?.plannedMinutes ?? 0) + (day?.completedMinutes ?? 0)}{" "}
                      min
                    </p>
                  </>
                </div>
                <a class="action-secondary" href={"/dashboard?week=" + startOfWeek(selectedDay)}>
                  Zobacz realizację
                </a>
              </>
            </header>
            {!day?.sessions.length && (
              <div class="empty-state">
                <h3>Ten dzień jest jeszcze wolny</h3>
                <p>Dodaj np. angielski o 09:00 na 60 minut. Możesz zapisać kilka zajęć tego samego dnia.</p>
              </div>
            )}
            <ul class="calendar-entry-list">
              {day?.sessions.map((session) => (
                <li
                  id={"entry-" + session.id}
                  data-testid="calendar-session"
                  class:list={["calendar-entry", session.status === "done" && "is-done"]}
                >
                  <div class="entry-heading">
                    <div>
                      <p class="entry-time tnum">{timeRange(session.startTime, session.minutes)}</p>
                      <h3>{session.topicTitle}</h3>
                      <p class="text-ink-muted mt-1 text-sm">
                        {session.minutes} min ·{" "}
                        {session.status === "done"
                          ? "zrobione"
                          : session.status === "skipped"
                            ? "pominięte"
                            : "do zrobienia"}
                      </p>
                    </div>
                    <form method="POST" action={"/api/sessions/" + session.id}>
                      <input type="hidden" name="month" value={monthStart} />
                      <input type="hidden" name="day" value={selectedDay} />
                      <input type="hidden" name="status" value={session.status === "done" ? "planned" : "done"} />
                      <button type="submit" class="action-secondary" data-testid="panel-mark-done">
                        {session.status === "done" ? "Cofnij ukończenie" : "✓ Zrobione"}
                      </button>
                    </form>
                  </div>
                  <div class="entry-actions">
                    {session.status !== "done" && (
                      <details class="entry-edit">
                        <summary>Edytuj zajęcie</summary>
                        <div class="mt-4">
                          <CalendarEntryForm
                            id={session.id}
                            title={session.topicTitle}
                            date={session.date}
                            startTime={session.startTime}
                            minutes={session.minutes}
                            month={monthStart}
                          />
                        </div>
                      </details>
                    )}
                    <form method="POST" action={"/api/sessions/" + session.id}>
                      <input type="hidden" name="_action" value="delete" />
                      <input type="hidden" name="month" value={monthStart} />
                      <input type="hidden" name="day" value={selectedDay} />
                      <button
                        type="submit"
                        data-testid="panel-delete-session"
                        disabled={session.status === "done"}
                        class="delete-entry"
                        title={session.status === "done" ? "Najpierw cofnij ukończenie zajęcia" : "Usuń zajęcie"}
                      >
                        Usuń
                      </button>
                    </form>
                  </div>
                  {session.status === "done" && (
                    <p class="text-ink-muted mt-3 text-xs">Aby edytować lub usunąć, najpierw cofnij ukończenie.</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        </div>
      </>
    )
  }
</AppLayout>
<script>
  document
    .querySelectorAll("input[type=number]")
    .forEach((field) => field.addEventListener("focus", () => (field as HTMLInputElement).select()));
</script>
