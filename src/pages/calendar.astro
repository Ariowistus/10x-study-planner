---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { loadMonthView, todayIso, type MonthView } from "@/lib/planning";
import { addMonths, isIsoDate, startOfMonth, startOfWeek } from "@/domain/date";

export const prerender = false;

// Unauthenticated requests never reach this page: `/calendar` is listed in
// PROTECTED_ROUTES and the middleware redirects them to sign-in.

const today = todayIso();
const requested = Astro.url.searchParams.get("month");
const monthStart = startOfMonth(isIsoDate(requested) ? requested : today);
const openDay = Astro.url.searchParams.get("day");

const db = createClient(Astro.request.headers, Astro.cookies);

let month: MonthView | null = null;
let loadError: string | null = null;

if (db) {
  try {
    month = await loadMonthView(db, monthStart, today);
  } catch (cause) {
    loadError = cause instanceof Error ? cause.message : "Nie udało się wczytać kalendarza";
  }
} else {
  loadError = "Supabase nie jest skonfigurowany";
}

const MONTHS = [
  "Styczeń",
  "Luty",
  "Marzec",
  "Kwiecień",
  "Maj",
  "Czerwiec",
  "Lipiec",
  "Sierpień",
  "Wrzesień",
  "Październik",
  "Listopad",
  "Grudzień",
];
const DAY_HEADERS = ["pon.", "wt.", "śr.", "czw.", "pt.", "sob.", "niedz."];

const statusLabel: Record<string, string> = {
  planned: "zaplanowane",
  done: "zrobione",
  skipped: "pominięte",
};

function monthName(iso: string): string {
  return `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
}

function formatMinutes(total: number): string {
  const hours = Math.floor(total / 60);
  const minutes = total % 60;
  if (hours === 0) return `${minutes} min`;
  if (minutes === 0) return `${hours} godz.`;
  return `${hours} godz. ${minutes} min`;
}

const previousMonth = addMonths(monthStart, -1);
const nextMonth = addMonths(monthStart, 1);

const ghostButton =
  "rounded-[10px] border border-line px-3 py-2 text-sm font-medium text-ink-muted transition-colors hover:border-line-strong hover:text-ink";
const tinyButton = "rounded-[10px] border px-2 py-1 text-[11px] font-medium transition-colors active:translate-y-px";
const panelField =
  "w-full rounded-[10px] border border-line bg-raised px-2 py-1.5 text-[12px] text-ink transition-colors focus:border-brand focus:outline-none";
---

<AppLayout
  title="Kalendarz"
  subtitle="Kliknij dzień, żeby dopisać temat i czas. Cały miesiąc widać z lotu ptaka."
  active="calendar"
>
  {
    loadError && (
      <p class="border-danger-line bg-danger-soft text-danger mb-8 rounded-[10px] border px-4 py-3 text-sm">
        {loadError}
      </p>
    )
  }

  {
    month && (
      <>
        <section class="border-line mb-8 flex flex-wrap items-end justify-between gap-6 border-b pb-6">
          <div>
            <p data-testid="month-name" class="text-lg font-medium tracking-tight">
              {monthName(month.monthStart)}
            </p>
            <p class="tnum text-ink-muted mt-2 text-sm">
              <span data-testid="month-completed" class="text-brand font-medium">
                {formatMinutes(month.completedMinutes)}
              </span>
              {" zrobione, "}
              <span data-testid="month-planned" class="text-ink font-medium">
                {formatMinutes(month.plannedMinutes)}
              </span>
              {" zaplanowane"}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <a href={`/calendar?month=${previousMonth}`} data-testid="previous-month" class:list={ghostButton}>
              Poprzedni
            </a>
            <a href="/calendar" class:list={ghostButton}>
              Dziś
            </a>
            <a href={`/calendar?month=${nextMonth}`} data-testid="next-month" class:list={ghostButton}>
              Następny
            </a>
          </div>
        </section>

        <datalist id="topic-names">
          {month.topics.map((topic) => (
            <option value={topic.title} />
          ))}
        </datalist>

        <p class="text-ink-muted mb-3 text-xs md:hidden">
          Przesuń kalendarz w bok, aby zobaczyć wszystkie dni tygodnia.
        </p>
        <div class="overflow-x-auto">
          <div class="min-w-[720px]">
            <div class="text-ink-faint mb-2 grid grid-cols-7 gap-2 text-[11px] font-medium tracking-wide uppercase">
              {DAY_HEADERS.map((name) => (
                <span>{name}</span>
              ))}
            </div>

            <div class="flex flex-col gap-2">
              {month.weeks.map((week) => (
                <div class="grid grid-cols-7 items-start gap-2">
                  {week.map((day) => {
                    const busy = day.plannedMinutes + day.completedMinutes;

                    return (
                      /* The cell is the control: opening it reveals the day's blocks and the
                         form that adds another. A details element keeps that working with no
                         client JavaScript, which is how the rest of this interface behaves. */
                      <details
                        data-testid="calendar-day"
                        data-date={day.date}
                        data-in-month={String(day.inMonth)}
                        open={openDay === day.date}
                        class:list={[
                          "group/day rounded-[10px] border p-2 transition-colors",
                          day.isToday ? "border-brand-line bg-brand-soft" : "border-line bg-raised",
                          !day.inMonth ? "opacity-60" : "",
                        ]}
                      >
                        <summary class="min-h-[92px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                          <div class="mb-1.5 flex items-baseline justify-between gap-1">
                            <span
                              class:list={[
                                "tnum text-[12px]",
                                day.isToday ? "text-brand font-semibold" : "font-medium",
                              ]}
                            >
                              {day.date.slice(8)}
                            </span>
                            <span class="tnum text-ink-faint text-[10px]">{busy > 0 ? `${busy} min` : "—"}</span>
                          </div>

                          {day.sessions.length > 0 && (
                            <ul class="flex flex-col gap-1">
                              {day.sessions.slice(0, 3).map((session) => (
                                <li
                                  data-testid="calendar-session"
                                  class:list={[
                                    "flex items-baseline justify-between gap-1 rounded px-1 py-0.5 text-[10px] leading-tight",
                                    session.status === "done"
                                      ? "bg-brand-soft text-brand"
                                      : session.status === "skipped"
                                        ? "text-ink-faint line-through"
                                        : "bg-sunken text-ink-muted",
                                  ]}
                                  title={`${session.topicTitle} — ${session.minutes} min`}
                                >
                                  <span class="truncate">{session.topicTitle}</span>
                                  <span class="tnum shrink-0 opacity-75">{session.minutes} min</span>
                                </li>
                              ))}
                              {day.sessions.length > 3 && (
                                <li class="text-ink-faint text-[10px]">+{day.sessions.length - 3} więcej</li>
                              )}
                            </ul>
                          )}

                          <span
                            data-testid="day-add-hint"
                            class:list={[
                              "text-ink-faint inline-block text-[10px] underline underline-offset-2 group-open/day:hidden",
                              day.sessions.length > 0 ? "mt-1.5" : "",
                            ]}
                          >
                            + dodaj
                          </span>
                        </summary>

                        <div class="border-line mt-2 border-t pt-2">
                          {day.sessions.length > 0 && (
                            <ul class="mb-2 flex flex-col gap-2">
                              {day.sessions.map((session) => (
                                <li class="border-line border-b pb-2 last:border-b-0 last:pb-0">
                                  <p class="text-[11px] leading-snug font-medium">{session.topicTitle}</p>
                                  <p class="tnum text-ink-faint mt-0.5 text-[10px]">
                                    {session.minutes} min · {statusLabel[session.status]}
                                  </p>

                                  <div class="mt-1.5 flex flex-wrap gap-1">
                                    {session.status === "done" && (
                                      <form method="POST" action={`/api/sessions/${session.id}`}>
                                        <input type="hidden" name="status" value="planned" />
                                        <input type="hidden" name="month" value={month.monthStart} />
                                        <button type="submit" class:list={[tinyButton, "border-line text-ink-muted"]}>
                                          Cofnij ukończenie
                                        </button>
                                      </form>
                                    )}
                                    {session.status !== "done" && (
                                      <form method="POST" action={`/api/sessions/${session.id}`}>
                                        <input type="hidden" name="status" value="done" />
                                        <input type="hidden" name="month" value={month.monthStart} />
                                        <button
                                          type="submit"
                                          data-testid="panel-mark-done"
                                          class:list={[tinyButton, "border-brand-line text-brand hover:bg-brand-soft"]}
                                        >
                                          Zrobione
                                        </button>
                                      </form>
                                    )}
                                    <form method="POST" action={`/api/sessions/${session.id}`}>
                                      <input type="hidden" name="_action" value="delete" />
                                      <input type="hidden" name="month" value={month.monthStart} />
                                      <button
                                        type="submit"
                                        data-testid="panel-delete-session"
                                        disabled={session.status === "done"}
                                        title={
                                          session.status === "done" ? "Najpierw cofnij ukończenie sesji" : "Usuń sesję"
                                        }
                                        class:list={[tinyButton, "border-danger-line text-danger hover:bg-danger-soft"]}
                                      >
                                        Usuń
                                      </button>
                                    </form>
                                  </div>
                                </li>
                              ))}
                            </ul>
                          )}

                          <form method="POST" action="/api/sessions" class="flex flex-col gap-1.5">
                            <input type="hidden" name="date" value={day.date} />
                            <input type="hidden" name="month" value={month.monthStart} />

                            <input
                              type="text"
                              name="newTopicTitle"
                              maxlength="200"
                              required
                              list="topic-names"
                              placeholder="Temat"
                              aria-label="Temat"
                              data-testid="panel-new-topic"
                              class:list={panelField}
                            />

                            <div class="flex items-center gap-1">
                              <input
                                type="number"
                                name="minutes"
                                value="60"
                                min="1"
                                max="1440"
                                step="1"
                                aria-label="Minuty"
                                data-testid="panel-minutes"
                                class:list={["tnum", panelField]}
                              />
                              <button
                                type="submit"
                                data-testid="panel-add-session"
                                class="bg-brand text-brand-contrast hover:bg-brand-hover shrink-0 rounded-[10px] px-2.5 py-1.5 text-[11px] font-medium transition-colors active:translate-y-px"
                              >
                                Dodaj
                              </button>
                            </div>
                          </form>

                          <a
                            href={`/dashboard?week=${startOfWeek(day.date)}`}
                            class="text-ink-faint hover:text-ink mt-2 inline-block text-[10px] underline underline-offset-2"
                          >
                            Otwórz tydzień
                          </a>
                        </div>
                      </details>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>
        </div>

        <p class="text-ink-faint mt-6 text-[13px]">
          Sesje dodane ręcznie zostają na miejscu, także wtedy, gdy w widoku
          <a href="/dashboard" class="hover:text-ink mx-1 underline underline-offset-2">
            Plan
          </a>
          poprosisz o automatyczne rozplanowanie tygodnia — reguła omija wieczory, które już zająłeś. Szacowany czas,
          priorytet i termin tematu ustawisz na stronie
          <a href="/topics" class="hover:text-ink mx-1 underline underline-offset-2">
            Tematy
          </a>
          .
        </p>
      </>
    )
  }
</AppLayout>

<script>
  // The minute fields open with a value in them, so clicking in and typing would
  // append to it. Selecting on focus makes the existing value a suggestion.
  document.querySelectorAll("input[type=number]").forEach((field) => {
    field.addEventListener("focus", () => {
      (field as HTMLInputElement).select();
    });
  });
</script>
