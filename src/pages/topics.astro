---
import AppLayout from "@/layouts/AppLayout.astro";
import AvailabilityEditor from "@/components/AvailabilityEditor";
import { createClient } from "@/lib/supabase";
import { getAvailability, listTopics, toTopic } from "@/lib/repository";
import { remainingMinutes } from "@/domain/scheduler";
import type { Availability, Topic } from "@/domain/types";

export const prerender = false;

// Unauthenticated requests never reach this page: `/topics` is listed in
// PROTECTED_ROUTES and the middleware redirects them to sign-in.

const db = createClient(Astro.request.headers, Astro.cookies);

let topics: Topic[] = [];
let availability: Availability = [0, 0, 0, 0, 0, 0, 0];
let loadError: string | null = null;

if (db) {
  try {
    const [rows, saved] = await Promise.all([listTopics(db), getAvailability(db)]);
    topics = rows.map(toTopic);
    availability = saved;
  } catch (cause) {
    loadError = cause instanceof Error ? cause.message : "Could not load your data";
  }
} else {
  loadError = "Supabase is not configured";
}

const priorities = [1, 2, 3, 4, 5];

const field =
  "w-full rounded-[10px] border border-line bg-raised px-3 py-2 text-sm text-ink transition-colors focus:border-brand focus:outline-none";
const label = "text-[11px] font-medium tracking-wide text-ink-faint uppercase";
const primaryButton =
  "rounded-[10px] bg-brand px-4 py-2 text-sm font-medium text-brand-contrast transition-colors hover:bg-brand-hover active:translate-y-px";
---

<AppLayout title="Topics" subtitle="What you have to cover, and how much time you actually have." active="topics">
  {
    loadError && (
      <p class="border-danger-line bg-danger-soft text-danger mb-8 rounded-[10px] border px-4 py-3 text-sm">
        {loadError}
      </p>
    )
  }

  <section class="border-line mb-12 border-b pb-10">
    <h2 class="text-lg font-semibold tracking-tight">Your week</h2>
    <p class="text-ink-muted mt-1 mb-5 text-sm">
      Minutes you can realistically study on each day. Be honest rather than optimistic.
    </p>

    <form method="POST" action="/api/availability">
      <AvailabilityEditor client:load initial={[...availability]} />
      <button type="submit" data-testid="save-availability" class:list={["mt-5", primaryButton]}>
        Save availability
      </button>
    </form>
  </section>

  <section class="border-line mb-12 border-b pb-10">
    <h2 class="text-lg font-semibold tracking-tight">Add a topic</h2>
    <p class="text-ink-muted mt-1 mb-5 text-sm">
      An estimate you believe, a priority you mean, and a deadline only if there really is one.
    </p>

    <form method="POST" action="/api/topics" class="grid gap-4 sm:grid-cols-6">
      <label class="flex flex-col gap-1.5 sm:col-span-3">
        <span class:list={label}>Title</span>
        <input type="text" name="title" required maxlength="200" data-testid="topic-title" class:list={field} />
      </label>

      <label class="flex flex-col gap-1.5 sm:col-span-1">
        <span class:list={label}>Minutes</span>
        <input
          type="number"
          name="estimatedMinutes"
          required
          min="1"
          max="100000"
          step="1"
          value="120"
          data-testid="topic-estimate"
          class:list={["tnum", field]}
        />
      </label>

      <label class="flex flex-col gap-1.5 sm:col-span-1">
        <span class:list={label}>Priority</span>
        <select name="priority" data-testid="topic-priority" class:list={field}>
          {
            priorities.map((value) => (
              <option value={value} selected={value === 3}>
                {value}
              </option>
            ))
          }
        </select>
      </label>

      <label class="flex flex-col gap-1.5 sm:col-span-1">
        <span class:list={label}>Deadline</span>
        <input type="date" name="deadline" data-testid="topic-deadline" class:list={field} />
      </label>

      <div class="sm:col-span-6">
        <button type="submit" data-testid="add-topic" class:list={primaryButton}>Add topic</button>
      </div>
    </form>
  </section>

  <section>
    <h2 class="mb-5 text-lg font-semibold tracking-tight">Your topics</h2>

    {
      topics.length === 0 ? (
        <p
          data-testid="topics-empty"
          class="border-line-strong bg-raised text-ink-muted rounded-[10px] border border-dashed px-5 py-8 text-center text-[15px]"
        >
          Nothing here yet. Add the first topic above, then generate a plan.
        </p>
      ) : (
        <ul data-testid="topic-list" class="flex flex-col gap-4">
          {topics.map((topic) => {
            const left = remainingMinutes(topic);
            const percent =
              topic.estimatedMinutes === 0
                ? 0
                : Math.min(100, Math.round((topic.completedMinutes / topic.estimatedMinutes) * 100));

            return (
              <li
                data-testid="topic-item"
                data-topic-title={topic.title}
                class="border-line bg-raised rounded-[10px] border p-4"
              >
                <form method="POST" action={`/api/topics/${topic.id}`} class="grid gap-3 sm:grid-cols-6 sm:items-end">
                  <label class="flex flex-col gap-1.5 sm:col-span-2">
                    <span class:list={label}>Title</span>
                    <input type="text" name="title" value={topic.title} maxlength="200" class:list={field} />
                  </label>

                  <label class="flex flex-col gap-1.5 sm:col-span-1">
                    <span class:list={label}>Minutes</span>
                    <input
                      type="number"
                      name="estimatedMinutes"
                      value={topic.estimatedMinutes}
                      min="1"
                      max="100000"
                      step="1"
                      class:list={["tnum", field]}
                    />
                  </label>

                  <label class="flex flex-col gap-1.5 sm:col-span-1">
                    <span class:list={label}>Priority</span>
                    <select name="priority" class:list={field}>
                      {priorities.map((value) => (
                        <option value={value} selected={value === topic.priority}>
                          {value}
                        </option>
                      ))}
                    </select>
                  </label>

                  <label class="flex flex-col gap-1.5 sm:col-span-1">
                    <span class:list={label}>Deadline</span>
                    <input type="date" name="deadline" value={topic.deadline ?? ""} class:list={field} />
                  </label>

                  <div class="flex gap-2 sm:col-span-1">
                    <button
                      type="submit"
                      name="_action"
                      value="update"
                      class="border-line text-ink-muted hover:border-line-strong hover:text-ink rounded-[10px] border px-3 py-2 text-sm font-medium transition-colors active:translate-y-px"
                    >
                      Save
                    </button>
                    <button
                      type="submit"
                      name="_action"
                      value="delete"
                      data-testid="delete-topic"
                      class="border-danger-line text-danger hover:bg-danger-soft rounded-[10px] border px-3 py-2 text-sm font-medium transition-colors active:translate-y-px"
                    >
                      Delete
                    </button>
                  </div>
                </form>

                <div class="mt-4 flex items-center gap-3">
                  <div class="bg-sunken h-1 flex-1 overflow-hidden rounded-full">
                    <div class="bg-brand h-full rounded-full" style={`width: ${percent}%`} />
                  </div>
                  <p class="tnum text-ink-faint text-[12px] whitespace-nowrap">
                    {topic.completedMinutes}
                    {" done, "}
                    <span data-testid="topic-remaining" class="text-ink-muted font-medium">
                      {left}
                    </span>
                    {" left"}
                    {topic.status !== "active" && `, ${topic.status}`}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</AppLayout>
