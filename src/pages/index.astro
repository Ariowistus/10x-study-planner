---
import "../styles/global.css";
export const prerender = false;
---

<!doctype html>
<html lang="pl">
  <head
    ><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    /><title>Study Planner · Kalendarz i realizacja</title><meta
      name="description"
      content="Zapisuj zajęcia w kalendarzu i odhaczaj zrobione. Jeden widok do planowania czasu, drugi do śledzenia realizacji."
    /></head
  >
  <body class="bg-surface text-ink min-h-screen">
    <header class="border-line border-b">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5">
        <span class="font-semibold tracking-tight">Study Planner</span><a href="/auth/signin" class="action-secondary"
          >Zaloguj się</a
        >
      </div>
    </header>
    <main class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-2 lg:items-center lg:py-28">
      <section>
        <p class="text-brand mb-5 text-sm font-medium">Kalendarz + realizacja</p><h1
          class="text-5xl leading-[1.06] font-semibold tracking-tight sm:text-6xl"
        >
          Zapisz kiedy.<br />Odhacz zrobione.
        </h1><p class="text-ink-muted mt-6 max-w-lg text-lg leading-relaxed">
          Angielski w poniedziałek o 09:00? Dodaj go w kalendarzu. Gdy skończysz, odhacz zajęcie na liście i zobacz swój
          postęp.
        </p><div class="mt-8 flex flex-wrap gap-3">
          <a href="/auth/signup" class="action-primary">Załóż konto</a><a href="/auth/signin" class="action-secondary"
            >Zaloguj się</a
          >
        </div><p class="text-ink-muted mt-6 text-sm">Nazwa, dzień, godzina i czas trwania. Tyle wystarczy.</p>
      </section>
      <section class="topic-summary" aria-label="Przykład listy realizacji">
        <div class="mb-6 flex items-center justify-between gap-3">
          <h2>Poniedziałek</h2><span class="text-ink-muted text-xs">Przykładowy dzień</span>
        </div><div class="completion-strip">
          <div class="completion-score"><strong>1<span> / 3</span></strong><p>ukończonych zajęć</p></div><div
            class="completion-meter"
          >
            <div class="completion-track"><div style="width:33%"></div></div><p>60 minut za Tobą</p>
          </div>
        </div><ul>
          <li class="agenda-row is-done">
            <span class="completion-check grid place-items-center" aria-hidden="true">✓</span><div class="agenda-copy">
              <h3>Angielski · konwersacje</h3><p class="tnum">09:00–10:00 · 60 min</p>
            </div>
          </li>
          <li class="agenda-row">
            <span class="completion-check" aria-hidden="true"></span><div class="agenda-copy">
              <h3>Angielski · słówka</h3><p class="tnum">14:00–14:30 · 30 min</p>
            </div>
          </li>
          <li class="agenda-row">
            <span class="completion-check" aria-hidden="true"></span><div class="agenda-copy">
              <h3>Matematyka · zadania</h3><p class="tnum">17:00–18:00 · 60 min</p>
            </div>
          </li>
        </ul>
      </section>
    </main>
    <footer class="text-ink-muted border-line mx-auto max-w-6xl border-t px-6 py-6 text-xs">
      Projekt kursu 10xDevs · <a
        href="https://github.com/Ariowistus/10x-study-planner"
        class="underline underline-offset-4">Kod i dokumentacja</a
      >
    </footer>
  </body>
</html>
