---
import AuthLayout from "@/layouts/AuthLayout.astro";

export const prerender = false;

// Email confirmation is switched off for this project, so an account works the
// moment it is created. See the decision and what it costs in
// context/foundation/prd.md under open questions.
---

<AuthLayout title="Konto utworzone">
  <div class="border-brand-line bg-brand-soft rounded-[10px] border p-5">
    <p class="text-ink text-[15px]">Twoje konto jest gotowe. Zaloguj się i ustaw swój pierwszy tydzień.</p>
  </div>

  <a
    href="/auth/signin"
    class="bg-brand text-brand-contrast hover:bg-brand-hover mt-6 inline-flex items-center rounded-[10px] px-5 py-2.5 text-sm font-medium transition-colors active:translate-y-px"
  >
    Przejdź do logowania
  </a>
</AuthLayout>
