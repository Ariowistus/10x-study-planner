---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Załóż konto" intro="Twoje tematy i Twój plan zostają wyłącznie Twoje.">
  <SignUpForm serverError={error} client:load />

  <p class="text-ink-muted mt-6 text-sm">
    Masz już konto?
    <a href="/auth/signin" class="text-brand font-medium underline underline-offset-4">Zaloguj się</a>
  </p>
</AuthLayout>
