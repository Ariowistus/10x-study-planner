---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Create an account" intro="Your topics and your plan stay yours alone.">
  <SignUpForm serverError={error} client:load />

  <p class="text-ink-muted mt-6 text-sm">
    Already registered?
    <a href="/auth/signin" class="text-brand font-medium underline underline-offset-4">Sign in</a>
  </p>
</AuthLayout>
