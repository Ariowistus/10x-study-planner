---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignInForm from "@/components/auth/SignInForm";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Zaloguj się" intro="Wróć do tygodnia w miejscu, w którym go zostawiłeś.">
  <SignInForm serverError={error} client:load />

  <p class="text-ink-muted mt-6 text-sm">
    Nie masz jeszcze konta?
    <a href="/auth/signup" class="text-brand font-medium underline underline-offset-4">Załóż je</a>
  </p>
</AuthLayout>
