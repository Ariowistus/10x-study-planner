---
import "../styles/global.css";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} · 10x Study Planner</title>
  </head>
  <body class="bg-surface text-ink min-h-[100dvh]">
    {
      missingConfigs.map((cfg) => (
        <p class="border-danger-line bg-danger-soft text-danger border-b px-4 py-3 text-center text-sm">
          {cfg.message}
          {cfg.docsUrl && (
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-2">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
          )}
        </p>
      ))
    }

    <div class="mx-auto flex min-h-[100dvh] max-w-5xl flex-col px-4">
      <header class="flex h-16 shrink-0 items-center">
        <a href="/" class="text-[15px] font-semibold tracking-tight">Study Planner</a>
      </header>

      <main class="flex flex-1 items-start justify-center pt-10 pb-20 sm:pt-16">
        <div class="w-full max-w-sm">
          <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
          {intro && <p class="text-ink-muted mt-2 mb-8 text-[15px]">{intro}</p>}
          {!intro && <div class="mb-8" />}

          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
