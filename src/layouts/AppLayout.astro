---
import "../styles/global.css";

interface Props {
  title: string;
  subtitle?: string;
  active: "dashboard" | "topics";
}

const { title, subtitle, active } = Astro.props;
const { user } = Astro.locals;

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const navBase =
  "rounded-[10px] px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2";
const navOn = "bg-brand-soft text-brand";
const navOff = "text-ink-muted hover:bg-sunken hover:text-ink";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} · 10x Study Planner</title>
  </head>
  <body class="bg-surface text-ink min-h-[100dvh]">
    <header class="border-line bg-surface/85 sticky top-0 z-30 border-b backdrop-blur-sm">
      <div class="mx-auto flex h-16 max-w-5xl items-center gap-4 px-4">
        <a href="/dashboard" class="text-ink text-[15px] font-semibold tracking-tight whitespace-nowrap">
          Study Planner
        </a>

        <nav class="flex items-center gap-1" aria-label="Główna">
          <a href="/dashboard" class:list={`${navBase} ${active === "dashboard" ? navOn : navOff}`}>Plan</a>
          <a href="/topics" class:list={`${navBase} ${active === "topics" ? navOn : navOff}`}>Tematy</a>
        </nav>

        <div class="ml-auto flex items-center gap-3">
          <span data-testid="current-user" class="text-ink-faint hidden text-sm sm:inline">{user?.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="border-line text-ink-muted hover:border-line-strong hover:text-ink rounded-[10px] border px-3 py-1.5 text-sm font-medium transition-colors"
            >
              Wyloguj się
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 pt-10 pb-20">
      <div class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight sm:text-[28px]">{title}</h1>
        {subtitle && <p class="text-ink-muted mt-1.5 text-[15px]">{subtitle}</p>}
      </div>

      {
        ok && (
          <p
            data-testid="flash-ok"
            role="status"
            class="border-brand-line bg-brand-soft text-brand mb-8 rounded-[10px] border px-4 py-3 text-sm"
          >
            {ok}
          </p>
        )
      }
      {
        error && (
          <p
            data-testid="flash-error"
            role="alert"
            class="border-danger-line bg-danger-soft text-danger mb-8 rounded-[10px] border px-4 py-3 text-sm"
          >
            {error}
          </p>
        )
      }

      <slot />
    </main>
  </body>
</html>
